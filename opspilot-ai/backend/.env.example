# ---- Database ----
# SQLite file lives inside backend/data/. No server to install or run.
DATABASE_URL=sqlite:///./data/opspilot.db

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM (Groq — OpenAI-compatible API) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Embeddings ----
# Groq does not currently serve an embeddings endpoint, so embeddings for the
# RAG module use a small local sentence-transformers model instead (set up in
# Phase 9). No key needed for that. This var is kept for future flexibility.
EMBEDDING_MODEL=local

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (read by Next.js, not this backend) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
